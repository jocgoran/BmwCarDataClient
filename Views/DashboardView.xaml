<UserControl x:Class="BmwCarDataClient.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:local="clr-namespace:BmwCarDataClient"
             xmlns:loc="clr-namespace:BmwCarDataClient.Localization"
             Margin="20">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:InverseBoolConverter x:Key="InverseBooleanConverter" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
        <Grid>
            <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Text="{Binding Source={x:Static loc:TranslationSource.Instance}, Path=[Dashboard_Title]}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
            
            <GroupBox Grid.Column="1" Header="{Binding Source={x:Static loc:TranslationSource.Instance}, Path=[Dashboard_MqttStatus]}" Padding="10">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="12" Height="12" Fill="{Binding MqttStatusColor, FallbackValue=Red}" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding MqttStatusText, FallbackValue=Disconnesso}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- L'immagine del veicolo -->
        <Border Grid.Row="1" CornerRadius="8" Background="#F3F3F3" Padding="10" Margin="0,0,0,20" Height="200">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- L'immagine del veicolo (Convertita da ByteArray a BitmapImage) -->
                <Image Grid.Column="0" 
                       HorizontalAlignment="Left" 
                       Source="{Binding VehicleImage}" 
                       Stretch="Uniform" 
                       Width="300" />

                <!-- Titolo a fianco -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock Text="{Binding Source={x:Static loc:TranslationSource.Instance}, Path=[Dashboard_YourBmw]}" FontSize="24" FontWeight="Bold" Foreground="#0066B1" />
                    <TextBlock Text="{Binding Vin}" FontSize="14" Foreground="Gray" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,0,0,20">
            <TextBlock FontSize="20" FontWeight="SemiBold" Margin="0,15,0,5" Text="{Binding Source={x:Static loc:TranslationSource.Instance}, Path=[Dashboard_LiveStreamTitle]}"/>
                    
            <!-- Info Banner per Streaming -->
            <Border Background="#E6F2FA" BorderBrush="#0066B1" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10" Padding="10">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Video" Foreground="#0066B1" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Foreground="#004A80" Text="{Binding Source={x:Static loc:TranslationSource.Instance}, Path=[Dashboard_StreamingInfo]}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Button Command="{Binding LoadInitialStateAndStreamCommand}" Content="{Binding Source={x:Static loc:TranslationSource.Instance}, Path=[Dashboard_StartStreaming]}" Height="35" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left"/>

            <!-- Status Message with Emoji Indicators -->
            <TextBlock Text="{Binding LiveStreamStatusMessage}" FontWeight="Bold" Margin="0,10,0,5" TextWrapping="Wrap" FontSize="14"/>

            <!-- Console Nera MQTT -->
            <TextBox AcceptsReturn="True" Background="#1E1E1E" FontFamily="Consolas" Foreground="#00FF00" IsReadOnly="True" Margin="0,10,0,0" MaxHeight="250" MinHeight="150" Padding="10" ScrollViewer.VerticalScrollBarVisibility="Auto" Text="{Binding LiveStreamJson}" TextWrapping="Wrap"/>
        </StackPanel>

        <GroupBox Grid.Row="3" Header="{Binding Source={x:Static loc:TranslationSource.Instance}, Path=[Dashboard_LicenseHeader]}" Margin="0,0,0,20">
            <StackPanel Margin="10">
                <!-- Freemium Status -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Visibility="{Binding IsPremiumUnlocked, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding Source={x:Static loc:TranslationSource.Instance}, Path=[Dashboard_TrialRemaining]}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock FontSize="16" FontWeight="Bold" Foreground="#0066B1" Text="{Binding FreeRequestsRemaining}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Premium Unlocked Status -->
                <TextBlock FontWeight="Bold" Foreground="#00AA00" Text="{Binding Source={x:Static loc:TranslationSource.Instance}, Path=[Dashboard_PremiumActive]}" Margin="0,0,0,10" Visibility="{Binding IsPremiumUnlocked, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Token Input -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox IsEnabled="{Binding IsPremiumUnlocked, Converter={StaticResource InverseBooleanConverter}}" Text="{Binding PremiumToken, UpdateSourceTrigger=PropertyChanged}" ui:ControlHelper.Header="{Binding Source={x:Static loc:TranslationSource.Instance}, Path=[Dashboard_PremiumTokenHeader]}"/>
                    <Button Content="{Binding Source={x:Static loc:TranslationSource.Instance}, Path=[Dashboard_BuyToken]}" Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource AccentButtonStyle}" ToolTip="{Binding Source={x:Static loc:TranslationSource.Instance}, Path=[Dashboard_BuyTokenTooltip]}" VerticalAlignment="Bottom"/>
                </Grid>
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="4" Margin="0,0,0,20">
            <TextBlock FontSize="20" FontWeight="SemiBold" Margin="0,15,0,5" Text="{Binding Source={x:Static loc:TranslationSource.Instance}, Path=[Dashboard_PackagesTitle]}"/>

            <!-- Info Banner per Pacchetti Premium -->
            <Border Background="#FFF4CE" BorderBrush="#D29200" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10" Padding="10">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Library" Foreground="#D29200" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Foreground="#7A5500" Text="{Binding Source={x:Static loc:TranslationSource.Instance}, Path=[Dashboard_PackagesInfo]}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- StackPanel con i Toggle Switch -->
            <StackPanel Margin="0,10,0,0">

                <Border Background="#F3F3F3" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="16" FontWeight="Bold" Text="Cabin Domain"/>
                                    <TextBlock FontSize="12" Foreground="Gray" VerticalAlignment="Center" Text="{Binding C1.ContainerId, StringFormat='[ID: {0}]'}"/>
                                </StackPanel>
                                <TextBlock Foreground="Gray" FontSize="12" Text="Dati relativi all'abitacolo, clima, infotainment e sedili."/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsOn="{Binding C1.IsActive, Mode=TwoWay}" OffContent="Spento" OnContent="Attivo"/>
                        </Grid>
                        <TextBox Background="#FAFAFA" FontFamily="Consolas" IsReadOnly="True" Margin="0,5,0,0" MaxHeight="120" MinHeight="40" ScrollViewer.VerticalScrollBarVisibility="Auto" Text="{Binding C1.Data}" Visibility="{Binding C1.IsActive, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>

                <Border Background="#F3F3F3" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="16" FontWeight="Bold" Text="Drivetrain Domain"/>
                                    <TextBlock FontSize="12" Foreground="Gray" VerticalAlignment="Center" Text="{Binding C2.ContainerId, StringFormat='[ID: {0}]'}"/>
                                </StackPanel>
                                <TextBlock Foreground="Gray" FontSize="12" Text="Parametri di trazione, cambio e gestione trasmissione."/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsOn="{Binding C2.IsActive, Mode=TwoWay}" OffContent="Spento" OnContent="Attivo"/>
                        </Grid>
                        <TextBox Background="#FAFAFA" FontFamily="Consolas" IsReadOnly="True" Margin="0,5,0,0" MaxHeight="120" MinHeight="40" ScrollViewer.VerticalScrollBarVisibility="Auto" Text="{Binding C2.Data}" Visibility="{Binding C2.IsActive, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>

                <Border Background="#F3F3F3" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="16" FontWeight="Bold" Text="Powertrain Domain"/>
                                    <TextBlock FontSize="12" Foreground="Gray" VerticalAlignment="Center" Text="{Binding C3.ContainerId, StringFormat='[ID: {0}]'}"/>
                                </StackPanel>
                                <TextBlock Foreground="Gray" FontSize="12" Text="Dati motore, carburante, autonomia e propulsione."/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsOn="{Binding C3.IsActive, Mode=TwoWay}" OffContent="Spento" OnContent="Attivo"/>
                        </Grid>
                        <TextBox Background="#FAFAFA" FontFamily="Consolas" IsReadOnly="True" Margin="0,5,0,0" MaxHeight="120" MinHeight="40" ScrollViewer.VerticalScrollBarVisibility="Auto" Text="{Binding C3.Data}" Visibility="{Binding C3.IsActive, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>

                <Border Background="#F3F3F3" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="16" FontWeight="Bold" Text="Body Domain"/>
                                    <TextBlock FontSize="12" Foreground="Gray" VerticalAlignment="Center" Text="{Binding C4.ContainerId, StringFormat='[ID: {0}]'}"/>
                                </StackPanel>
                                <TextBlock Foreground="Gray" FontSize="12" Text="Stato carrozzeria, porte, finestrini, serrature e luci esterne."/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsOn="{Binding C4.IsActive, Mode=TwoWay}" OffContent="Spento" OnContent="Attivo"/>
                        </Grid>
                        <TextBox Background="#FAFAFA" FontFamily="Consolas" IsReadOnly="True" Margin="0,5,0,0" MaxHeight="120" MinHeight="40" ScrollViewer.VerticalScrollBarVisibility="Auto" Text="{Binding C4.Data}" Visibility="{Binding C4.IsActive, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>

                <Border Background="#F3F3F3" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="16" FontWeight="Bold" Text="Chassis Domain"/>
                                    <TextBlock FontSize="12" Foreground="Gray" VerticalAlignment="Center" Text="{Binding C5.ContainerId, StringFormat='[ID: {0}]'}"/>
                                </StackPanel>
                                <TextBlock Foreground="Gray" FontSize="12" Text="Dati su ruote, pressione pneumatici, freni e assetto."/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsOn="{Binding C5.IsActive, Mode=TwoWay}" OffContent="Spento" OnContent="Attivo"/>
                        </Grid>
                        <TextBox Background="#FAFAFA" FontFamily="Consolas" IsReadOnly="True" Margin="0,5,0,0" MaxHeight="120" MinHeight="40" ScrollViewer.VerticalScrollBarVisibility="Auto" Text="{Binding C5.Data}" Visibility="{Binding C5.IsActive, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>

                <Border Background="#F3F3F3" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="16" FontWeight="Bold" Text="Trip Domain"/>
                                    <TextBlock FontSize="12" Foreground="Gray" VerticalAlignment="Center" Text="{Binding C6.ContainerId, StringFormat='[ID: {0}]'}"/>
                                </StackPanel>
                                <TextBlock Foreground="Gray" FontSize="12" Text="Statistiche di viaggio, chilometraggio, consumi e GPS."/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsOn="{Binding C6.IsActive, Mode=TwoWay}" OffContent="Spento" OnContent="Attivo"/>
                        </Grid>
                        <TextBox Background="#FAFAFA" FontFamily="Consolas" IsReadOnly="True" Margin="0,5,0,0" MaxHeight="120" MinHeight="40" ScrollViewer.VerticalScrollBarVisibility="Auto" Text="{Binding C6.Data}" Visibility="{Binding C6.IsActive, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>

                <Border Background="#F3F3F3" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="16" FontWeight="Bold" Text="Status Domain"/>
                                    <TextBlock FontSize="12" Foreground="Gray" VerticalAlignment="Center" Text="{Binding C7.ContainerId, StringFormat='[ID: {0}]'}"/>
                                </StackPanel>
                                <TextBlock Foreground="Gray" FontSize="12" Text="Stato generale, manutenzione, scadenze CBS e check control."/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsOn="{Binding C7.IsActive, Mode=TwoWay}" OffContent="Spento" OnContent="Attivo"/>
                        </Grid>
                        <TextBox Background="#FAFAFA" FontFamily="Consolas" IsReadOnly="True" Margin="0,5,0,0" MaxHeight="120" MinHeight="40" ScrollViewer.VerticalScrollBarVisibility="Auto" Text="{Binding C7.Data}" Visibility="{Binding C7.IsActive, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>

                <Border Background="#F3F3F3" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="16" FontWeight="Bold" Text="Channel Domain"/>
                                    <TextBlock FontSize="12" Foreground="Gray" VerticalAlignment="Center" Text="{Binding C8.ContainerId, StringFormat='[ID: {0}]'}"/>
                                </StackPanel>
                                <TextBlock Foreground="Gray" FontSize="12" Text="Dati di connessione, telematica, reti e comunicazione."/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsOn="{Binding C8.IsActive, Mode=TwoWay}" OffContent="Spento" OnContent="Attivo"/>
                        </Grid>
                        <TextBox Background="#FAFAFA" FontFamily="Consolas" IsReadOnly="True" Margin="0,5,0,0" MaxHeight="120" MinHeight="40" ScrollViewer.VerticalScrollBarVisibility="Auto" Text="{Binding C8.Data}" Visibility="{Binding C8.IsActive, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>

                <Border Background="#F3F3F3" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="16" FontWeight="Bold" Text="Electrical System Domain"/>
                                    <TextBlock FontSize="12" Foreground="Gray" VerticalAlignment="Center" Text="{Binding C9.ContainerId, StringFormat='[ID: {0}]'}"/>
                                </StackPanel>
                                <TextBlock Foreground="Gray" FontSize="12" Text="Tensioni batteria, diagnostica ECU e sistema elettrico."/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsOn="{Binding C9.IsActive, Mode=TwoWay}" OffContent="Spento" OnContent="Attivo"/>
                        </Grid>
                        <TextBox Background="#FAFAFA" FontFamily="Consolas" IsReadOnly="True" Margin="0,5,0,0" MaxHeight="120" MinHeight="40" ScrollViewer.VerticalScrollBarVisibility="Auto" Text="{Binding C9.Data}" Visibility="{Binding C9.IsActive, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>

                <Border Background="#F3F3F3" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="16" FontWeight="Bold" Text="Vehicle Domain"/>
                                    <TextBlock FontSize="12" Foreground="Gray" VerticalAlignment="Center" Text="{Binding C10.ContainerId, StringFormat='[ID: {0}]'}"/>
                                </StackPanel>
                                <TextBlock Foreground="Gray" FontSize="12" Text="Dati di base del veicolo, identificazione e movimento."/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsOn="{Binding C10.IsActive, Mode=TwoWay}" OffContent="Spento" OnContent="Attivo"/>
                        </Grid>
                        <TextBox Background="#FAFAFA" FontFamily="Consolas" IsReadOnly="True" Margin="0,5,0,0" MaxHeight="120" MinHeight="40" ScrollViewer.VerticalScrollBarVisibility="Auto" Text="{Binding C10.Data}" Visibility="{Binding C10.IsActive, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </StackPanel>



        </Grid>
    </ScrollViewer>
</UserControl>
