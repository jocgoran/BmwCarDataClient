<UserControl Margin="20" x:Class="BmwCarDataClient.Views.ContainersView" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:ui="http://schemas.modernwpf.com/2019" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:BmwCarDataClient.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Visible">
        <StackPanel>
            
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding Source={x:Static loc:TranslationSource.Instance}, Path=[Containers_Title]}" Margin="0,0,0,20"/>

            <!-- GESTIONE ESISTENTI E PULIZIA -->
            <GroupBox Header="{Binding Source={x:Static loc:TranslationSource.Instance}, Path=[Containers_Section1_Header]}" Margin="0,0,0,20">
                <StackPanel Margin="10">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Command="{Binding GetContainersCommand}" Content="{Binding Source={x:Static loc:TranslationSource.Instance}, Path=[Containers_GetActive]}" Height="35" Style="{StaticResource AccentButtonStyle}" Margin="0,0,10,0"/>
                        <Button Background="#FF4444" Command="{Binding DeleteAllContainersCommand}" Content="{Binding Source={x:Static loc:TranslationSource.Instance}, Path=[Containers_DeleteAll]}" Foreground="White" Height="35"/>
                    </StackPanel>
                    
                    <StackPanel Margin="0,5,0,10" Orientation="Horizontal">
                        <Ellipse Fill="{Binding GetContainersStatusColor}" Height="12" VerticalAlignment="Center" Width="12" Margin="0,0,10,0"/>
                        <TextBlock FontWeight="Bold" Text="{Binding GetContainersStatusMessage}" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox IsReadOnly="True" Margin="0,0,5,0" MaxHeight="150" MinHeight="100" ScrollViewer.VerticalScrollBarVisibility="Auto" Text="{Binding ContainersJson}" TextWrapping="Wrap"/>
                        <TextBox Foreground="#FF4444" Grid.Column="1" IsReadOnly="True" Margin="5,0,0,0" MaxHeight="150" MinHeight="100" ScrollViewer.VerticalScrollBarVisibility="Auto" Text="{Binding DeleteContainersStatus}" TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- DISTRIBUZIONE DA CSV -->
            <GroupBox Header="{Binding Source={x:Static loc:TranslationSource.Instance}, Path=[Containers_Section2_Header]}" Margin="0,0,0,20">
                <StackPanel Margin="10">
                    <TextBlock Foreground="Gray" Text="{Binding Source={x:Static loc:TranslationSource.Instance}, Path=[Containers_Section2_Info]}" Margin="0,0,0,10"/>
                    <Button Command="{Binding DeployContainersCommand}" Content="{Binding Source={x:Static loc:TranslationSource.Instance}, Path=[Containers_Deploy]}" Height="35" Margin="0,0,0,10"/>
                    <TextBox Background="#F3F3F3" FontFamily="Consolas" IsReadOnly="True" MaxHeight="300" MinHeight="200" ScrollViewer.VerticalScrollBarVisibility="Auto" Text="{Binding ContainerDeploymentStatus}" TextWrapping="Wrap"/>
                </StackPanel>
            </GroupBox>

            <!-- SMART MAINTENANCE -->
            <GroupBox Header="{Binding Source={x:Static loc:TranslationSource.Instance}, Path=[Containers_Section3_Header]}">
                <StackPanel Margin="10">
                    <Button Command="{Binding GetSmartMaintenanceCommand}" Content="{Binding Source={x:Static loc:TranslationSource.Instance}, Path=[Containers_GetSmartMaintenance]}" Height="35" Margin="0,0,0,10"/>
                    
                    <StackPanel Margin="0,5,0,10" Orientation="Horizontal">
                        <Ellipse Fill="{Binding GetSmartMaintenanceStatusColor}" Height="12" VerticalAlignment="Center" Width="12" Margin="0,0,10,0"/>
                        <TextBlock FontWeight="Bold" Text="{Binding GetSmartMaintenanceStatusMessage}" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <TextBox FontFamily="Consolas" IsReadOnly="True" MaxHeight="200" MinHeight="100" ScrollViewer.VerticalScrollBarVisibility="Auto" Text="{Binding SmartMaintenanceJson}" TextWrapping="Wrap"/>
                </StackPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
