<UserControl x:Class="BmwCarDataClient.Views.VehicleInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:loc="clr-namespace:BmwCarDataClient.Localization"
             Margin="20">
    <ScrollViewer VerticalScrollBarVisibility="Visible">
        <StackPanel HorizontalAlignment="Center">
            <StackPanel.LayoutTransform>
                <ScaleTransform ScaleX="1.3" ScaleY="1.3"/>
            </StackPanel.LayoutTransform>

            <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding Source={x:Static loc:TranslationSource.Instance}, Path=[VehicleInfo_Title]}" Margin="0,0,0,15" HorizontalAlignment="Center"/>
            
            <Border Background="#E6F2FA" BorderBrush="#0066B1" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,15" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Document" Foreground="#0066B1" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Foreground="#004A80" Text="{Binding Source={x:Static loc:TranslationSource.Instance}, Path=[VehicleInfo_Info]}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Grid Margin="0,10,0,5" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <Button Command="{Binding LoadBasicVehicleDataCommand}" 
                            Content="Scarica Dati Veicolo" 
                            Style="{StaticResource AccentButtonStyle}" 
                            Height="35" 
                            HorizontalAlignment="Left"
                            Padding="15,0"
                            Margin="0,0,0,8"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Ellipse Width="12" Height="12" Fill="{Binding BasicDataStatusColor}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding BasicDataStatusMessage}" 
                                   FontWeight="Bold" 
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                
                <Image Grid.Column="1" 
                       Source="{Binding VehicleImage}" 
                       Stretch="Uniform" 
                       Width="220" 
                       Margin="15,0,0,0" 
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"/>
            </Grid>

            <ItemsControl ItemsSource="{Binding BasicVehicleDataList}" Margin="0,10,0,0" HorizontalAlignment="Center">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FAFAFA" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8" Padding="15,12" Width="600">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Text="{Binding Key}" 
                                           Foreground="#555555" 
                                           FontSize="14" 
                                           VerticalAlignment="Center"/>
                                
                                <TextBlock Grid.Column="1" 
                                           Text="{Binding Value}" 
                                           FontWeight="Bold" 
                                           FontSize="16" 
                                           Foreground="#000000" 
                                           TextWrapping="Wrap" 
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
